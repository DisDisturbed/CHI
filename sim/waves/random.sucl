# Starter signal list for Surfer. Space opens its command prompt; the same commands work there.
variable_add Tb_HNF_Random.clk
variable_add Tb_HNF_Random.resetn
divider_add merged_request
variable_add Tb_HNF_Random.dut.merged_req_v
variable_add Tb_HNF_Random.dut.merged_req_flit.srcid
variable_add Tb_HNF_Random.dut.merged_req_flit.txnid
variable_add Tb_HNF_Random.dut.merged_req_flit.opcode
variable_add Tb_HNF_Random.dut.merged_req_flit.addr
variable_add Tb_HNF_Random.dut.merged_req_taken
divider_add trackers
variable_add Tb_HNF_Random.dut.tracker_ready.tracker_ready[0]
variable_add Tb_HNF_Random.dut.tracker_ready.tracker_ready[1]
variable_add Tb_HNF_Random.dut.tracker_ready.tracker_ready[2]
variable_add Tb_HNF_Random.dut.tracker_ready.tracker_ready[3]
divider_add trk_txnid
scope_add Tb_HNF_Random.dut.trk_txnid.trk_txnid
