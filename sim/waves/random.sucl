# Starter signal list for Surfer. Space opens its command prompt; the same commands work there.
variable_add Tb_HNF_Random.clk
variable_add Tb_HNF_Random.resetn
divider_add rnf0_request
variable_add Tb_HNF_Random.dut.rnf_req[0].flitv
variable_add Tb_HNF_Random.dut.rnf_req[0].lcrdv
variable_add Tb_HNF_Random.dut.rnf_req[0].flit.srcid
variable_add Tb_HNF_Random.dut.rnf_req[0].flit.txnid
variable_add Tb_HNF_Random.dut.rnf_req[0].flit.opcode
variable_add Tb_HNF_Random.dut.rnf_req[0].flit.addr
divider_add rnf1_request
variable_add Tb_HNF_Random.dut.rnf_req[1].flitv
variable_add Tb_HNF_Random.dut.rnf_req[1].lcrdv
variable_add Tb_HNF_Random.dut.rnf_req[1].flit.srcid
variable_add Tb_HNF_Random.dut.rnf_req[1].flit.txnid
variable_add Tb_HNF_Random.dut.rnf_req[1].flit.opcode
variable_add Tb_HNF_Random.dut.rnf_req[1].flit.addr
divider_add trackers
variable_add Tb_HNF_Random.dut.tracker_ready.tracker_ready[0]
variable_add Tb_HNF_Random.dut.tracker_ready.tracker_ready[1]
variable_add Tb_HNF_Random.dut.tracker_ready.tracker_ready[2]
variable_add Tb_HNF_Random.dut.tracker_ready.tracker_ready[3]
variable_add Tb_HNF_Random.dut.gen_tshr[0].u_tshr_inst.state_q
variable_add Tb_HNF_Random.dut.gen_tshr[1].u_tshr_inst.state_q
variable_add Tb_HNF_Random.dut.gen_tshr[2].u_tshr_inst.state_q
variable_add Tb_HNF_Random.dut.gen_tshr[3].u_tshr_inst.state_q
variable_add Tb_HNF_Random.dut.trk_hazard.trk_hazard[0]
variable_add Tb_HNF_Random.dut.trk_hazard.trk_hazard[1]
variable_add Tb_HNF_Random.dut.trk_hazard.trk_hazard[2]
variable_add Tb_HNF_Random.dut.trk_hazard.trk_hazard[3]
divider_add trk_txnid
scope_add Tb_HNF_Random.dut.trk_txnid.trk_txnid
