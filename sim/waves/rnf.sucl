variable_add Tb_RNF.core_if.req.cacheable
variable_add Tb_RNF.core_if.rsp.valid
variable_add Tb_RNF.core_if.rsp.data
variable_add Tb_RNF.core_if.rsp.err
variable_add Tb_RNF.core_if.rsp.chr_state
