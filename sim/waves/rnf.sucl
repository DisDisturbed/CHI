variable_add Tb_RNF.dut.r_q.txnid
variable_add Tb_RNF.dut.r_q.way
variable_add Tb_RNF.dut.s_q.state
variable_add Tb_RNF.dut.s_q.opcode
variable_add Tb_RNF.dut.s_q.addr
variable_add Tb_RNF.dut.s_q.resp
