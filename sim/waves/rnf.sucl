variable_add Tb_RNF.dut.tag_re
variable_add Tb_RNF.dut.tag_we
variable_add Tb_RNF.dut.tag_set
variable_add Tb_RNF.dut.tag_way
variable_add Tb_RNF.dut.tag_st
