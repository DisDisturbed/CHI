# GTKWave settings for this workspace, arranged to feel closer to Vivado xsim.
# `make wave` loads this file. To use it everywhere, copy it to ~/.gtkwaverc.

# ---- look ----
hier_max_level 1          # short signal names, H in the wave window toggles full paths
left_justify_sigs 1
show_base_symbols 0       # 1EC instead of $1EC
highlight_wavewindow 1    # the selected signal is highlighted in the waves too
splash_disable 1
do_initial_zoom_fit 1     # open with the whole run in view

# ---- mouse: wheel scrolls signals, Ctrl+wheel zooms at the cursor ----
use_scrollwheel_as_y 1
alt_wheel_mode 1

# ---- keys ----
accel "/Time/Zoom/Zoom In" <Control>equal
accel "/Time/Zoom/Zoom Out" <Control>minus
accel "/Time/Zoom/Zoom Best Fit" <Control>0
accel "/Time/Zoom/Zoom Full" (null)
accel "/Markers/Find Next Edge" <Control>Right
accel "/Markers/Find Previous Edge" <Control>Left
accel "/File/Reload Waveform" F5
accel "/Edit/Combine Up" (null)
accel "/Edit/Data Format/Enum" <Alt>E
