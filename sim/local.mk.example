# Per-PC settings. Copy to sim/local.mk (not in git) and keep only the lines
# this PC needs. The Makefile finds the usual locations without this file;
# `make doctor` shows what it found.

# Linux: where Verilator is installed
# VERILATOR_ROOT = /home/yusuf/verilator

# Windows: MSYS2 install (default: %LOCALAPPDATA%/msys64, then C:/msys64)
# MSYS2_ROOT = C:/msys64

# Wave viewers, if not on PATH. On Windows use a /c/... path.
# SURFER  = /c/tools/surfer/surfer.exe
# GTKWAVE = gtkwave
# VIEWER  = gtkwave

# Fewer compile jobs on a smaller machine
# JOBS = 4
